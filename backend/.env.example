APP_NAME=Khidmapp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_SUPPORTED_LOCALES=fr,ar
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=khidmapp
DB_USERNAME=khidmapp
DB_PASSWORD=khidmapp

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=khidmapp_cache

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@khidmapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage fichiers (S3 en prod, MinIO en local/dev via docker-compose)
AWS_ACCESS_KEY_ID=khidmapp
AWS_SECRET_ACCESS_KEY=khidmapp_secret
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=khidmapp
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/khidmapp

# JWT (php-open-source-saver/jwt-auth)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Bankily (paiement automatique)
BANKILY_BASE_URL=
BANKILY_API_KEY=
BANKILY_MERCHANT_ID=
BANKILY_WEBHOOK_SECRET=

# Moteur de calcul de prix
DEFAULT_MARGIN_PERCENT=20
DEFAULT_CURRENCY_PAIR=EUR_MRU

VITE_APP_NAME="${APP_NAME}"
